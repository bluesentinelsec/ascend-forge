/**
 * @file version.h
 * @brief Package version API (generated from VERSION + cmake/version.h.in).
 *
 * Do not edit this file by hand. Change the root VERSION file and reconfigure.
 */

#ifndef ASCEND_FORGE_VERSION_H
#define ASCEND_FORGE_VERSION_H

/** Semantic version major component. */
#define ASCEND_FORGE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
/** Semantic version minor component. */
#define ASCEND_FORGE_VERSION_MINOR @PROJECT_VERSION_MINOR@
/** Semantic version patch component. */
#define ASCEND_FORGE_VERSION_PATCH @PROJECT_VERSION_PATCH@

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @brief Package version string.
 *
 * @return Semantic version such as "0.1.0". Never empty. The caller does not free it.
 */
const char *Version_String(void);

#ifdef __cplusplus
}
#endif

#endif /* ASCEND_FORGE_VERSION_H */
